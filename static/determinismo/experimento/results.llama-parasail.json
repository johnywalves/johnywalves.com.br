  "prompts": {
    "specSystem": "Você é o módulo de classificação de um chat de suporte. Siga a política billing.cancellation.v3.\nPolítica:\n- \"cancelar\" significa encerrar a assinatura ao fim do ciclo atual.\n- \"reembolso do mês passado\" significa reembolsar o ciclo de cobrança anterior.\n- Intenções permitidas: billing_agent, tech_support, security_review.\n- Ações permitidas: cancel_subscription, refund_previous_cycle. Liste em ordem alfabética.\nResponda somente com o JSON do schema. Nunca escreva texto fora do JSON.",
    "specSchema": {
      "name": "decisao",
      "strict": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "actions",
          "refund_cycle"
        ],
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "billing_agent",
              "tech_support",
              "security_review"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cancel_subscription",
                "refund_previous_cycle"
              ]
            }
          },
          "refund_cycle": {
            "type": "string",
            "enum": [
              "previous"
            ]
          }
        }
      }
    },
    "controlSystem": "Você atende clientes de uma assinatura. Responda ao cliente."
  },
